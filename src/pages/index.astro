---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site.ts';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Sergey Romanenko',
  alternateName: 'Awilum',
  url: SITE.url,
  image: `${SITE.url}/about/sergey-romanenko.jpg`,
  sameAs: [
    SITE.github,
    SITE.mainSite,
    'https://stepik.org/users/awilum',
    'https://awilum.t.me',
  ],
  jobTitle: 'Software Engineer, Open-Source Creator, Photographer, Educator',
  description:
    'Sergey Romanenko (Awilum) is a software engineer and open-source creator. He builds developer tools, libraries and content-management systems, creates programming courses, and photographs people and places.',
  knowsAbout: [
    'JavaScript',
    'PHP',
    'Frontend Development',
    'Open Source',
    'Software Architecture',
    'Photography',
    'Education',
  ],
};

const work = [
  {
    title: 'Open-Source Software',
    body: 'Libraries, tools and frameworks across PHP, JavaScript, frontend tooling and content-management systems — built to be examined, reused and improved.',
  },
  {
    title: 'Developer Tools',
    body: 'Small, practical utilities: HTML minifiers, email templates, time-zone helpers, benchmarking tools and more.',
  },
  {
    title: 'Content & Education',
    body: 'Programming courses, books and open learning materials that make technical subjects approachable without losing the details that matter.',
  },
  {
    title: 'Photography',
    body: 'Travel, street, portrait and documentary work exploring people, places and everyday life.',
  },
];
---

<BaseLayout
  title="Awilum — Sergey Romanenko | Open-Source Developer & Creator"
  description="Sergey Romanenko (Awilum): open-source developer, creator of libraries, tools and content-management systems. Explore his work on GitHub or visit his main website."
  path="/"
  jsonLd={person}
>
  <section class="flex flex-col items-center gap-8 py-12 text-center sm:py-20">
    <img
      src="/about/sergey-romanenko.jpg"
      alt="Portrait of Sergey Romanenko (Awilum)"
      class="h-36 w-36 rounded-full object-cover object-top ring-1 ring-rule sm:h-44 sm:w-44"
      loading="eager"
      width="176"
      height="176"
    />
    <div class="max-w-2xl">
      <p class="label-eyebrow">Awilum</p>
      <h1 class="display mt-3 text-title text-ink">Sergey Romanenko</h1>
      <p class="mt-6 text-lede text-muted">
        Software engineer, open-source creator, photographer and educator. I
        build practical tools, libraries and content-management systems, teach
        programming, and document the people and places I encounter.
      </p>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a href={SITE.mainSite} class="btn btn-accent" rel="noopener">
        Visit sergeyromanenko.com
      </a>
      <a href={SITE.github} class="btn btn-secondary" rel="noopener">
        GitHub profile
      </a>
      <a href="/about/" class="btn btn-ghost">
        About
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-3xl py-12">
    <h2 class="display text-head text-ink">Who I am</h2>
    <p class="mt-6 text-lede text-muted">
      I've spent my life moving between disciplines, places and ways of
      understanding the world — from computers and software to teaching,
      photography, independent projects and travel. Today I work across code,
      cameras and education, building software and practical tools, creating
      learning resources, and photographing people, streets and everyday life.
    </p>
    <p class="mt-4 text-lede text-muted">
      What connects it all is a desire to understand things firsthand, make
      something meaningful from what I discover, and share the result with
      others.
    </p>
  </section>

  <section class="py-12">
    <h2 class="display text-head text-ink text-center">What I do</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {work.map((w) => (
        <article class="rounded-2xl border border-rule p-6">
          <h3 class="text-lg font-semibold text-ink">{w.title}</h3>
          <p class="mt-2 text-muted">{w.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-3xl py-12 text-center">
    <h2 class="display text-head text-ink">Explore more</h2>
    <p class="mt-4 text-lede text-muted">
      Projects, writing, photography and courses all live on my main website. My
      code is open source on GitHub.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href={SITE.mainSite} class="btn btn-accent" rel="noopener">
        Go to sergeyromanenko.com
      </a>
      <a href={SITE.github} class="btn btn-secondary" rel="noopener">
        Browse repositories
      </a>
    </div>
  </section>
</BaseLayout>
