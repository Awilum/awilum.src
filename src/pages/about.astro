---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '@/lib/site.ts';
import stats from '@/data/about-stats.json';

const num = (value: number | null | undefined, fallback = '—'): string =>
  typeof value === 'number' ? value.toLocaleString('en-US') : fallback;

const retrieved = new Date(stats.retrievedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const sourceStatus = (name: string): string => {
  const s = stats.sources.find((x) => x.source === name);
  return s?.status === 'ok' ? s.retrievedAt : 'unavailable';
};

const teaching = [
  {
    label: 'Courses',
    value: num(
      stats.stepik?.createdCoursesCount ??
        stats.stepStat?.metrics?.createdCourses,
    ),
    note: 'published on Stepik, including career programs',
  },
  {
    label: 'Lessons',
    value: num(
      stats.stepik?.createdLessonsCount ?? stats.stepStat?.metrics?.lessons,
    ),
    note: 'across the published catalogue',
  },
  {
    label: 'Enrollments',
    value: num(stats.stepStat?.metrics?.students),
    note: 'students on courses, from StepStat',
  },
  {
    label: 'Reviews',
    value: num(stats.stepStat?.metrics?.reviews),
    note: 'learner reviews received',
  },
  {
    label: 'Quizzes',
    value: num(stats.stepStat?.metrics?.quizzes),
    note: 'graded questions across the catalogue',
  },
  {
    label: 'Code tasks',
    value: num(stats.stepStat?.metrics?.codeTasks),
    note: 'hands-on programming tasks',
  },
  {
    label: 'Followers',
    value: num(
      stats.stepik?.followersCount ?? stats.stepStat?.metrics?.followers,
    ),
    note: 'on Stepik',
  },
  {
    label: 'Certificates issued',
    value: num(
      stats.stepik?.issuedCertificatesCount ??
        stats.stepStat?.metrics?.certificatesIssued,
    ),
    note: 'issued to course completers',
  },
  {
    label: 'Reputation',
    value: num(stats.stepik?.reputation),
    note: stats.stepik?.reputationRank
      ? `rank ${stats.stepik?.reputationRank} on Stepik`
      : 'on Stepik',
  },
];

const development = [
  {
    label: 'Followers',
    value: num(stats.github?.followers),
    note: 'on GitHub',
  },
  {
    label: 'Member since',
    value: stats.github?.memberSince
      ? new Date(stats.github.memberSince).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
        })
      : 'July 2013',
    note: 'GitHub account created',
  },
];

// ---------------------------------------------------------------------------
// The record. Real chronology, from the primary biography on sergeyromanenko.com. What continues is listed first, then what is finished.
const currentPractice = [
  {
    when: '2023–present',
    title: 'Online Education',
    detail:
      'I create and teach programming courses on Stepik, covering subjects including SQL, JavaScript, Python, PHP, Go, Kotlin, Java, C# and Markdown. The catalogue spans individual trainers and bundled career programs, built around long sequences of problems to solve rather than videos to sit through.',
  },
  {
    when: '2016–present',
    title: 'Photography & Documentary Projects',
    detail:
      'I develop independent photographic projects focused on people, places, streets and everyday life. Professional work has covered portraiture, street photography, fashion, photojournalism and documentary photography. Earlier in this period I also organized photography walks, creative projects and workshops.',
  },
  {
    when: '2010–present',
    title: 'Open-Source Software',
    detail:
      'I develop and contribute to open-source software across PHP, JavaScript, frontend tooling, content-management systems and developer utilities. I build reusable solutions, improve existing projects, and share practical tools and knowledge with the wider development community.',
  },
  {
    when: 'present',
    title: 'Software & Research and Development',
    detail:
      'I continue to work with software through independent development, technical problem-solving and research and development. My background includes frontend engineering, application architecture, APIs, automation, testing, localization, and broader contract development.',
  },
  {
    when: 'present',
    title: 'Books & Publications',
    detail:
      'I create educational publications and practical learning resources, including open materials. My publishing work focuses on making technical knowledge accessible through clear explanations, useful examples, and formats that readers can use independently.',
  },
  {
    when: 'present',
    title: 'Independent Tools & Logic Games',
    detail:
      'I build small, practical tools and logic games in response to real needs. These projects combine software development, experimentation, and a preference for useful solutions without unnecessary complexity.',
  },
];

const earlierChapters = [
  {
    when: '2022–2024',
    title: 'Professional Mentoring',
    detail:
      'I mentored developers through Solvery.io, providing individualized programming guidance, practical technical advice, and support with professional development.',
  },
  {
    when: '2018–2019',
    title: 'Event Photography & Model Scouting',
    detail:
      'I combined freelance event photography with model scouting for Liberty and Sigma Model Agency, developing my photographic skills while working closely with models and aspiring talent.',
  },
  {
    when: '2010–2020',
    title: 'Software Engineering & Contract Development',
    detail:
      'I worked in software engineering and frontend development for an international print-on-demand company, progressing from Software Engineer to Senior Frontend Developer. My responsibilities evolved from core software development to building and maintaining customer-facing web interfaces and supporting the company’s web infrastructure: frontend architecture, user interface development, reusable components, responsive design, performance optimization, API integrations and cross-system compatibility. Alongside my primary role, I pursued independent development and contract projects across different areas of software engineering.',
  },
  {
    when: '2004–2010',
    title: 'Computer Engineering & Early Software Development',
    detail:
      'I studied computer engineering, specializing in systems programming, with a focus on programming fundamentals, software development and computer systems. My coursework included cryptography and encryption, as well as computer graphics programming in C and C++. My graduation project involved developing a content management system. I also completed training in Cisco networking technologies. Alongside my formal education, I worked with a broad range of programming languages and technologies, including C, C++, C#, Java, x86 assembly, PHP, JavaScript, Delphi and Free Pascal, and founded and ran the PascalGames community, publishing resources related to Delphi, Free Pascal and game development.',
  },
];

const practice = [
  {
    term: 'Engineering — Understanding How Things Work',
    detail:
      'My work in software has taught me to approach complicated problems with curiosity, patience, and a willingness to look beneath the surface. I work with application architecture, frontend development, APIs, testing, and independent technical projects. I continue to explore software through research and development, building practical solutions and investigating better ways to solve real problems.',
  },
  {
    term: 'Education — Making Knowledge Useful',
    detail:
      'I turn technical experience into learning resources that help people understand concepts and apply them independently. Through programming courses, practical exercises, books, documentation, and mentoring, I work to make complex subjects more approachable without stripping away the details that matter.',
  },
  {
    term: 'Photography — Paying Attention to People and Place',
    detail:
      'Photography gives me a way to explore the world through direct observation. I photograph people, streets, architecture, and everyday situations, with a growing focus on travel, street, portrait, and documentary photography. My personal projects explore the quieter and more complicated sides of human experience: belonging, distance, memory, and the feeling of trying to find a place in the world.',
  },
  {
    term: 'Independent Creation — Building and Sharing',
    detail:
      'Alongside my client work and teaching, I develop open-source software, publish practical resources, and build small tools that solve specific problems. I value independent work that can be examined, reused, improved, and shared. These projects give me room to experiment, follow an idea beyond its initial purpose, and make something useful available to other people.',
  },
];

const projects = [
  {
    name: 'Flextype',
    role: 'Creator & maintainer',
    repo: 'https://github.com/flextype/flextype',
    note: 'Flat-file content management system, hosted in its own organisation.',
  },
  {
    name: 'Thermage',
    role: 'Creator & maintainer',
    repo: 'https://github.com/thermage/thermage',
    note: 'A fluent PHP library for styling CLI output — colour, background, formatting and theming.',
  },
  {
    name: 'Markdown — the book',
    role: 'Author',
    repo: 'https://github.com/Awilum/markdown',
    note: 'The educational book “Markdown”, with a Pandoc build system that generates PDF and EPUB.',
  },
  {
    name: 'SQL Introduction — the book',
    role: 'Author',
    repo: 'https://github.com/Awilum/sql-introduction',
    note: 'The educational book “SQL Introduction”, in the same Pandoc build system.',
  },
  {
    name: 'wp-html-minifier',
    role: 'Creator',
    repo: 'https://github.com/Awilum/wp-html-minifier',
    note: 'A WordPress plugin that improves overall site performance by minifying HTML output.',
  },
  {
    name: 'wp-api-explorer',
    role: 'Creator',
    repo: 'https://github.com/Awilum/wp-api-explorer',
    note: 'A WordPress plugin that adds an API Explorer link for pages, posts, tags, categories and comments.',
  },
];

const aboutPage = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${SITE.url}/about/#aboutpage`,
  url: `${SITE.url}/about/`,
  name: 'About Sergey Romanenko (Awilum)',
  description:
    'The professional profile of Sergey Romanenko (Awilum): software engineer, open-source creator, educator on Stepik and photographer. Verified statistics, career timeline, projects and teaching record.',
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    name: SITE.title,
    url: SITE.url,
  },
  mainEntity: { '@id': 'https://sergeyromanenko.com/#person' },
  breadcrumb: { '@id': `${SITE.url}/about/#breadcrumb` },
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${SITE.url}/about/#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'About',
      item: `${SITE.url}/about/`,
    },
  ],
};

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://sergeyromanenko.com/#person',
  name: 'Sergey Romanenko',
  alternateName: 'Awilum',
  url: SITE.mainSite,
  image: `${SITE.mainSite}/about/sergey-romanenko.jpg`,
  jobTitle: 'Software Engineer, Open-Source Creator, Photographer, Educator',
  description:
    'Sergey Romanenko (Awilum) is a software engineer, open-source creator, photographer and educator.',
  sameAs: [
    SITE.mainSite,
    SITE.github,
    'https://stepik.org/users/awilum',
    'https://stepstat.ru/user/561566563',
    'https://awilum.t.me',
  ],
};

const jsonLd = [person, aboutPage, breadcrumb];
---

<BaseLayout
  title="About — Sergey Romanenko (Awilum)"
  description="The professional profile of Sergey Romanenko (Awilum): software engineer, open-source creator, educator on Stepik and photographer. Verified statistics, career timeline, projects and teaching record."
  path="/about/"
  jsonLd={jsonLd}
>
  <article>
    <header class="w-full pb-12 pt-10 sm:pb-16 sm:pt-14">
      <p class="label-eyebrow">About</p>
      <h1 class="display mt-5 sm:mt-6 text-title">Sergey Romanenko</h1>
      <p class="meta-mono mt-7 border-t border-line pt-4 text-label sm:mt-8">
        Explorer · Photographer · Creator · Engineer
      </p>
    </header>

    <div class="grid grid-cols-1 gap-10 border-t border-rule pt-10 sm:pt-12 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5">
        <figure class="frame">
          <div class="aspect-[4/5] overflow-hidden">
            <img
              src="/about/sergey-romanenko.jpg"
              alt="Portrait of Sergey Romanenko (Awilum)"
              class="h-full w-full object-cover"
              loading="eager"
              width="800"
              height="1000"
            />
          </div>
        </figure>
        <p class="meta-mono mt-3 text-label">Hoi An, Vietnam</p>
      </div>
      <div class="lg:col-span-7">
        <div class="project-prose">
          <p>
            I’ve spent my life moving between disciplines, places, and ways of
            understanding the world. I began with computers and software,
            learning to take complicated systems apart and understand how they
            work. Over time, that curiosity expanded beyond the screen — into
            teaching, photography, independent projects, and the experience of
            living and travelling across different places and cultures.
          </p>
          <p>
            Today, I work across code, cameras, and education, while continuing
            to explore the world around me. I build software and practical
            tools, create learning resources, and photograph people, streets,
            and everyday life. Some of my work is technical and structured; some
            is personal, observational, and open-ended. What connects it is a
            desire to understand things firsthand, make something meaningful
            from what I discover, and share the result with others.
          </p>
          <p>
            The full picture — photography, courses, publications, tools and
            games — lives on{' '}
            <a href={SITE.mainSite} class="link-quiet" rel="noopener">
              sergeyromanenko.com
            </a>
            . This site is the developer portfolio: code, tools, and the record
            behind them.
          </p>
        </div>
      </div>
    </div>

    <section class="mt-20 sm:mt-28" aria-labelledby="connection">
      <p class="label-eyebrow">How it connects</p>
      <h2 id="connection" class="display mt-5 sm:mt-6 max-w-3xl text-head">
        Different disciplines. A shared <em>curiosity about how</em> the world
        works.
      </h2>
      <div class="mt-8 border-t border-line">
        {practice.map((thread, index) => (
          <div class="grid grid-cols-1 gap-3 border-b border-line py-8 sm:py-9 lg:grid-cols-12 lg:gap-8">
            <p class="meta-mono text-label lg:col-span-1">
              {String(index + 1).padStart(2, '0')}
            </p>
            <div class="lg:col-span-4">
              <h3 class="display text-subhead">{thread.term}</h3>
            </div>
            <p class="max-w-measure-wide text-pretty text-[1.0625rem] leading-relaxed text-muted lg:col-span-7">
              {thread.detail}
            </p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-20 sm:mt-28" aria-labelledby="statistics">
      <p class="label-eyebrow">The record</p>
      <h2 id="statistics" class="display mt-5 sm:mt-6 max-w-3xl text-head">
        What actually happened, and roughly when.
      </h2>
      <p class="standfirst mt-5 sm:mt-6 max-w-3xl">
        The figures below are generated data, not hand-typed content. They are
        refreshed from the public sources by the{' '}
        <a
          href="https://github.com/Awilum/awilum.src"
          class="link-quiet"
          rel="noopener"
        >
          refresh-data script
        </a>{' '}
        and committed automatically, so the page always states the date the
        numbers were last verified.
      </p>
      <p class="meta-mono mt-7 border-t border-line pt-4 text-label sm:mt-8">
        Retrieved {retrieved}
      </p>
      <div class="mt-8 border-t border-line">
        {[
          ...teaching.map((s) => ({ ...s, group: 'Teaching on Stepik' })),
          ...development.map((s) => ({
            ...s,
            group: 'Open source & development',
          })),
        ].map((s, index, all) => (
          <div class="grid grid-cols-1 gap-3 border-b border-line py-7 sm:py-8 lg:grid-cols-12 lg:gap-8">
            {index === 0 ||
            (index === teaching.length && all[index - 1].group !== s.group) ? (
              <p class="meta-mono text-label lg:col-span-1">{s.group}</p>
            ) : (
              <p
                class="meta-mono text-label lg:col-span-1"
                aria-hidden="true"
              />
            )}
            <div class="lg:col-span-4">
              <h3 class="display text-subhead">{s.label}</h3>
              <p class="mt-1 text-[1.0625rem] leading-relaxed text-muted">
                {s.note}
              </p>
            </div>
            <p class="lg:col-span-7">
              <span class="font-mono text-2xl text-ink">{s.value}</span>
            </p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-20 sm:mt-28" aria-labelledby="chronology">
      <p class="label-eyebrow">Chronology</p>
      <h2 id="chronology" class="display mt-5 sm:mt-6 max-w-3xl text-head">
        When it happened.
      </h2>
      <div class="mt-8 border-t border-line">
        <h3 class="label-micro mt-8">Currently</h3>
        <ol class="mt-3 border-t border-line" role="list">
          {currentPractice.map((milestone) => (
            <li class="grid grid-cols-1 gap-3 border-b border-line py-7 sm:py-8 lg:grid-cols-12 lg:gap-8">
              <p class="meta-mono text-label lg:col-span-2">{milestone.when}</p>
              <div class="lg:col-span-4">
                <h4 class="text-[1.0625rem] font-medium leading-snug text-ink">
                  {milestone.title}
                </h4>
              </div>
              <p class="max-w-measure-wide text-pretty text-[1rem] leading-relaxed text-muted lg:col-span-6">
                {milestone.detail}
              </p>
            </li>
          ))}
        </ol>
      </div>
      <div class="mt-14">
        <h3 class="label-micro">Earlier chapters</h3>
        <ol class="mt-3 border-t border-line" role="list">
          {earlierChapters.map((milestone) => (
            <li class="grid grid-cols-1 gap-3 border-b border-line py-7 sm:py-8 lg:grid-cols-12 lg:gap-8">
              <p class="meta-mono text-label lg:col-span-2">{milestone.when}</p>
              <div class="lg:col-span-4">
                <h4 class="text-[1.0625rem] font-medium leading-snug text-ink">
                  {milestone.title}
                </h4>
              </div>
              <p class="max-w-measure-wide text-pretty text-[1rem] leading-relaxed text-muted lg:col-span-6">
                {milestone.detail}
              </p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="mt-20 sm:mt-28" aria-labelledby="colophon">
      <p class="label-eyebrow">Colophon</p>
      <h2 id="colophon" class="display mt-5 sm:mt-6 max-w-3xl text-head">
        Where the numbers come from.
      </h2>
      <div class="mt-8 border-t border-line">
        {[
          {
            label: 'GitHub',
            href: 'https://github.com/Awilum',
            status: sourceStatus('GitHub'),
          },
          {
            label: 'Stepik',
            href: 'https://stepik.org/users/awilum',
            status: sourceStatus('Stepik'),
          },
          {
            label: 'StepStat',
            href: 'https://stepstat.ru/user/561566563',
            status: sourceStatus('StepStat'),
          },
          {
            label: 'LinkedIn',
            href: 'https://www.linkedin.com/in/sergey-romanenko',
            status: sourceStatus('LinkedIn'),
          },
        ].map((s) => (
          <div class="grid grid-cols-1 gap-3 border-b border-line py-6 sm:py-7 lg:grid-cols-12 lg:gap-8">
            <p class="meta-mono text-label lg:col-span-2">{s.label}</p>
            <div class="lg:col-span-10">
              <a href={s.href} class="link-quiet" rel="noopener">
                {s.href.replace(/^https:\/\//, '')}
              </a>
              <p class="mt-1 text-[0.8125rem] text-muted">
                Last verified {s.status}
              </p>
            </div>
          </div>
        ))}
      </div>
      <p class="mt-8 max-w-measure-wide text-[1rem] leading-relaxed text-muted">
        The statistics are refreshed from the public sources by the{' '}
        <a
          href="https://github.com/Awilum/awilum.src"
          class="link-quiet"
          rel="noopener"
        >
          refresh-data script
        </a>{' '}
        and committed automatically, so the page always states the date the
        numbers were last verified. If a source is unreachable, the page says so
        rather than silently keeping a stale number.
      </p>
    </section>
    <div class="mt-12 flex flex-wrap items-center gap-3 border-t border-line pt-6">
      <a href="/" class="btn btn-secondary">
        ← Back to Home
      </a>
      <a href={SITE.mainSite} class="btn btn-ghost" rel="noopener">
        Visit sergeyromanenko.com
      </a>
    </div>
  </article>
</BaseLayout>
