---
import { SITE } from '@/lib/site';

const year = new Date().getFullYear();
---

<!--
  A magazine colophon rather than a link dump: the identity set in the display
  serif, the section list as a running index, the verified profiles last, and
  the legal line as a small mono marginal note. One dark band closes the site —
  the only inverted surface outside the lightbox — so the last thing on a page
  is a deliberate stop rather than a fade-out.
-->

<footer class="mt-28 border-t border-rule sm:mt-36">
  <div class="mx-auto max-w-page px-5 sm:px-8 lg:px-12">
    <div class="grid grid-cols-1 gap-12 py-14 sm:grid-cols-2 sm:py-16 lg:grid-cols-12 lg:gap-12 lg:py-20">
      <div class="sm:col-span-2 lg:col-span-7">
        <p class="display text-[clamp(1.75rem,3.5vw,2.75rem)] leading-[1.05] tracking-[-0.015em]">
          Awilum
        </p>

        <div class="mt-5 max-w-2xl space-y-5 text-[1rem] leading-[1.85] text-muted text-pretty sm:text-[1.0625rem]">
          <p>
            <strong class="font-medium text-foreground">Awilum</strong> is an
            ancient online name I've carried since the beginning of my IT
            career. Derived from the Akkadian <em>awīlum</em>, meaning "human
            being" or "person", it traces back to the ancient world of
            Mesopotamia.
          </p>

          <p>
            Over the years, it has become more than a nickname. It represents my
            curiosity, independence, and fascination with exploring unfamiliar
            worlds, ideas, and possibilities. A small part of my own Wonderland.
          </p>

          <p>
            This is the developer portfolio of Sergey Romanenko, featuring
            open-source libraries, tools, content-management systems, and the
            code behind the courses, photography, and publications on{' '}
            <b>
              <a href={SITE.mainSite} class="link-quiet" rel="noopener">
                sergeyromanenko.com
              </a>
            </b>
            .
          </p>
        </div>
      </div>

      <div class="sm:col-span-1 lg:col-span-4 lg:col-start-9">
        <p class="label-eyebrow">Elsewhere</p>

        <ul class="mt-4 flex flex-col" role="list">
          <li>
            <a
              href={SITE.github}
              class="group flex items-baseline justify-between gap-3 py-1 text-[0.9375rem] leading-relaxed text-muted transition-colors duration-200 hover:text-ink"
              target="_blank"
              rel="noreferrer me"
            >
              <span class="link-quiet">GitHub</span>
              <span class="meta-mono text-label transition-colors group-hover:text-muted">
                @Awilum
              </span>
            </a>
          </li>

          <li>
            <a
              href="https://stepik.org/users/awilum"
              class="group flex items-baseline justify-between gap-3 py-1 text-[0.9375rem] leading-relaxed text-muted transition-colors duration-200 hover:text-ink"
              target="_blank"
              rel="noreferrer me"
            >
              <span class="link-quiet">Stepik</span>
              <span class="meta-mono text-label transition-colors group-hover:text-muted">
                @awilum
              </span>
            </a>
          </li>

          <li>
            <a
              href="https://awilum.t.me"
              class="group flex items-baseline justify-between gap-3 py-1 text-[0.9375rem] leading-relaxed text-muted transition-colors duration-200 hover:text-ink"
              target="_blank"
              rel="noreferrer me"
            >
              <span class="link-quiet">Telegram</span>
              <span class="meta-mono text-label transition-colors group-hover:text-muted">
                @awilum
              </span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col gap-2 border-t border-line py-7 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
      <p class="meta-mono text-label">
        © {year} All rights are reserved by Sergey Romanenko.
      </p>
    </div>
  </div>
</footer>
